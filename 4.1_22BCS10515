import java.util.ArrayList;
import java.util.Collection;

// Class representing a single card
class Card {
    String name;
    String symbol;

    public Card(String name, String symbol) {
        this.name = name;
        this.symbol = symbol;
    }

    public String getSymbol() {
        return symbol;
    }

    @Override
    public String toString() {
        return name + " (" + symbol + ")";
    }
}

// Class to store and manage cards
class CardCollection {
    private Collection<Card> cards; // Using Collection interface
    public CardCollection() {
        cards = new ArrayList<>(); // Using ArrayList to store cards
    }
    public void addCard(Card card) {
        cards.add(card);
    }
    public void displayCardsBySymbol(String symbol) {
        System.out.println("Cards with symbol '" + symbol + "':");
        for (Card card : cards) {
            if (card.getSymbol().equalsIgnoreCase(symbol)) {
                System.out.println(card);
            }
        }
    }
    public void displayAllCards() {
        System.out.println("All Cards:");
        for (Card card : cards) {
            System.out.println(card);
        }
    }
}

// Main class
public class CardManager {
    public static void main(String[] args) {
        CardCollection cardCollection = new CardCollection();

        // Adding some cards
        cardCollection.addCard(new Card("Ace of Spades", "Spades"));
        cardCollection.addCard(new Card("King of Hearts", "Hearts"));
        cardCollection.addCard(new Card("Queen of Diamonds", "Diamonds"));
        cardCollection.addCard(new Card("Jack of Spades", "Spades"));

        // Display all cards
        cardCollection.displayAllCards();

        // Find cards by symbol
        cardCollection.displayCardsBySymbol("Spades");
    }
}
